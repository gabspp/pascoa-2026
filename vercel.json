    { "source": "/loja(.html)?", "destination": "/brindes-2026", "permanent": false },
    { "source": "/informacoes(.html)?", "destination": "/brindes-2026", "permanent": false },
    { "source": "/admin(.html)?", "destination": "/brindes-2026", "permanent": false },
